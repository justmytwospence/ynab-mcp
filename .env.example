# YNAB personal access token (https://app.ynab.com/settings/developer)
YNAB_API_TOKEN=your-token-here
# Optional: comma-separated hostnames clients use, e.g. mcp.example.com
MCP_ALLOWED_HOSTS=
# Optional: enables configured tracking accounts (see README); keep public keys private.
RECONCILE_MAP=
# Optional: pre-provisioned BTCPay watch-only store, never a hot wallet.
# Give this key only the store-scoped btcpay.store.canviewwallet permission.
BTCPAY_URL=
BTCPAY_API_KEY=
# Indexed BTC movement dates use only getblockheader; no per-read UTXO scan.
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
