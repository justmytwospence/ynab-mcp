{
  "name": "ynab-mcp",
  "version": "2.0.0",
  "description": "A comprehensive YNAB MCP server exposing the full YNAB API",
  "main": "dist/index.js",
  "bin": {
    "ynab-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "tsx --test src/**/*.test.ts",
    "start:http": "MCP_TRANSPORT=http node dist/index.js"
  },
  "keywords": [
    "ynab",
    "mcp",
    "budget",
    "model-context-protocol"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.0",
    "hono": "^4.13.13",
    "ynab": "^4.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
